# ── Public (browser-safe) ──────────────────────────────────
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
# NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api

# ── Server only (never NEXT_PUBLIC_*) ──────────────────────
# HCS audit trail — required only if you use /api/hcs/*
# HEDERA_OPERATOR_ID=0.0.xxxxx
# HEDERA_OPERATOR_KEY=302e...   # or 0x-prefixed ECDSA
# HCS_AUDIT_TOPIC_ID=0.0.yyyyy

# Optional Mirror Node overrides
# HEDERA_MIRROR_TESTNET_URL=https://testnet.mirrornode.hedera.com
# HEDERA_MIRROR_MAINNET_URL=https://mainnet.mirrornode.hedera.com
